<?xml version="1.0" encoding="utf-8"?>
<!-- Only the benchmark build: lets Macrobenchmark read frame timing of a release-like app (U-31). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <profileable android:shell="true" tools:targetApi="29" />
        <!-- U-55: fills an empty app with example data for the benchmarks; the shell only. -->
        <receiver
            android:name="ru.maxrubtsoff.bankagg.benchmark.BenchmarkSeedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
