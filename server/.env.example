# Copy to .env and fill in.

# Long random token the app sends in the Authorization header.
# Generate one, e.g.:  openssl rand -hex 32
API_TOKEN=change-me-to-a-long-random-string

# Domain that points to this server's IP (needed for automatic HTTPS).
# A free option: a *.duckdns.org subdomain.
DOMAIN=bankagg.example.org
